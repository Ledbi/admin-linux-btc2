[Unit]
Description=Publication de etat.json pour le portail Helios
After=helios-collect.service

[Service]
Type=oneshot
User=helios-suivi
Group=helios-suivi
ExecStart=/usr/local/sbin/helios-suivi-publish.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/helios/suivi/www
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
